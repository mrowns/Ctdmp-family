[Unit]
Description=CTDMP development worker (MOCK only)
After=network.target docker.service
Requires=docker.service
[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ctdmp-connect
Environment=PATH=/home/ubuntu/.local/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/node/bin/node /home/ubuntu/ctdmp-connect/node_modules/tsx/dist/cli.mjs apps/worker/src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=300M
[Install]
WantedBy=multi-user.target
